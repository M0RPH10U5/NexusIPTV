<UserControl x:Class="NexusIPTV.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="0">

    <Grid Margin="12"
          MinHeight="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                Margin="0,0,0,6"
                Padding="10"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="NOW"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="CurrentTimeText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text=""/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="CurrentProgrammeText"
                               Text="No programme information"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CurrentDescriptionText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="2"
                Padding="10"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="NEXT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="NextTimeText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text=""/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="NextProgrammeText"
                               Text="No programme information"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="NextDescriptionText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>