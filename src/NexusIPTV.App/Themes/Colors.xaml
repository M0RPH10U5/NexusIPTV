<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme -->
    <Color x:Key="DarkBackgroundColor">#101114</Color>
    <Color x:Key="DarkSurfaceColor">#181A1F</Color>
    <Color x:Key="DarkSurfaceAltColor">#202329</Color>
    <Color x:Key="DarkBorderColor">#30343B</Color>
    <Color x:Key="DarkTextColor">#F2F3F5</Color>
    <Color x:Key="DarkSecondaryTextColor">#A9AFB8</Color>

    <!-- Light theme -->
    <Color x:Key="LightBackgroundColor">#F4F5F7</Color>
    <Color x:Key="LightSurfaceColor">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAltColor">#E9EBEF</Color>
    <Color x:Key="LightBorderColor">#D2D5DA</Color>
    <Color x:Key="LightTextColor">#17191C</Color>
    <Color x:Key="LightSecondaryTextColor">#626873</Color>

    <!-- Shared accent -->
    <Color x:Key="AccentColor">#4EA1FF</Color>
    <Color x:Key="AccentHoverColor">#6BB2FF</Color>

</ResourceDictionary>
