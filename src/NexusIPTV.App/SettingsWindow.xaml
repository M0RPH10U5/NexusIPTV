<Window x:Class="NexusIPTV.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        Height="450"
        MinWidth="500"
        MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <TextBlock Text="Settings"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="−"
                                Style="{DynamicResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>

                        <Button Content="×"
                                Style="{DynamicResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Settings content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <Grid Margin="28">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Settings"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="Configure Nexus IPTV."
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <!-- Theme -->
                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Theme"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <TextBlock Text="Choose between dark and light appearance."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                            </StackPanel>

                            <!-- Theme toggle -->
                            <ToggleButton x:Name="ThemeToggle"
                                          Grid.Column="1"
                                          Width="86"
                                          Height="34"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Click="ThemeToggle_Click"
                                          ToolTip="Switch between dark and light mode">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="SwitchBorder"
                                                Background="{DynamicResource TitleBarBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="17">

                                            <Grid>

                                                <!-- Labels -->
                                                <TextBlock x:Name="DarkLabel"
                                                           Text="☽"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>

                                                <TextBlock x:Name="LightLabel"
                                                           Text="🌣"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,9,0"/>

                                                <!-- Sliding knob -->
                                                <Border x:Name="SwitchKnob"
                                                        Width="26"
                                                        Height="26"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="13"
                                                        HorizontalAlignment="Left"
                                                        Margin="3"/>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <!-- Light mode -->
                                            <Trigger Property="IsChecked"
                                                     Value="False">

                                                <Setter TargetName="SwitchKnob"
                                                        Property="HorizontalAlignment"
                                                        Value="Right"/>

                                                <Setter TargetName="DarkLabel"
                                                        Property="Foreground"
                                                        Value="{DynamicResource SecondaryTextBrush}"/>

                                                <Setter TargetName="LightLabel"
                                                        Property="Foreground"
                                                        Value="{DynamicResource PrimaryTextBrush}"/>

                                            </Trigger>

                                            <!-- Hover -->
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="SwitchBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                        </Grid>

                    </Border>

                    <!-- Playlist -->
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                <TextBlock Text="Playlist"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <TextBlock x:Name="PlaylistPathText"
                                           Text="No playlist loaded."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                            </StackPanel>

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Content="Load Playlist…"
                                    Margin="0,16,0,0"
                                    Padding="14,7"
                                    Click="LoadPlaylistButton_Click"/>
                            
                        </Grid>

                    </Border>
                    
                    <!-- EPG -->
                    <Border Grid.Row="3"
                            Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                <TextBlock Text="EPG (Guide)"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="EpgPathText"
                                           Text="No EPG/Guide Loaded."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Content="Load EPG/Guide..."
                                    Margin="0,16,0,0"
                                    Padding="14,7"
                                    Click="LoadEpgButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Information -->
                    <Border Grid.Row="4"
                            Margin="0,8,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Nexus IPTV"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Settings are applied immediately."
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="Created By: M0RPH10U5 | Version: 1.0.0"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>